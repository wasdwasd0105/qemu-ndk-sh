+#if defined(__ANDROID__)
+/*
+ * On Android, /etc/resolv.conf does not exist. The Java side writes a
+ * resolv.conf to the app's private storage and passes its path via
+ * the SLIRP_RESOLV_CONF environment variable (set from JNI before QEMU
+ * starts). If the env var is not set or the file cannot be opened,
+ * we fall back to Google Public DNS (8.8.8.8).
+ */
+static const char *get_resolv_conf_path(void)
+{
+    const char *p = getenv("SLIRP_RESOLV_CONF");
+    if (p && *p) {
+        return p;
+    }
+    return RESOLV_CONF_PATH;
+}
+
+#define ANDROID_DEFAULT_DNS4 "8.8.8.8"
+#define ANDROID_DEFAULT_DNS6 "2001:4860:4860::8888"
+
+#else
+static const char *get_resolv_conf_path(void)
+{
+    return RESOLV_CONF_PATH;
+}
+#endif /* __ANDROID__ */
